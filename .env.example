# Gemini API Key (Server-only - never expose to frontend/Vite)
GEMINI_API_KEY=your_key_here
PORT=3001

# PostgreSQL Connection String (Prisma)
# Example for local PostgreSQL: postgresql://postgres:password@localhost:5432/notecraft?schema=public
# Example for cloud PostgreSQL (Neon, Supabase, AWS RDS): postgresql://...
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?schema=public"

# JWT Authentication Secret
JWT_SECRET="replace_with_a_long_random_secret_key"

# =========================================================================
# Object Storage Configuration (Cloud Media Storage)
# =========================================================================
# Default: If left unset, NOTECRAFT stores media in the secure server/uploads directory.
#
# Recommended Production Provider: Cloudflare R2 (Zero egress fees, generous free tier)
# 1. Create a Cloudflare account and create an R2 bucket (e.g. "notecraft-media-prod").
# 2. In R2 -> Manage R2 API Tokens -> Create API Token (Object Read & Write permission).
# 3. Enter the credentials below:
#
# R2_ACCOUNT_ID="your_cloudflare_account_id"
# R2_ACCESS_KEY_ID="your_r2_access_key_id"
# R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
# R2_BUCKET_NAME="notecraft-media-prod"
#
# Alternative: AWS S3
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="your_aws_access_key_id"
# AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
# AWS_S3_BUCKET="notecraft-media-prod"

# =========================================================================
# Email Service Configuration (Email Verification & Password Reset)
# =========================================================================
# Default: If left unset, email notifications (verification links, reset links)
# are simulated in the server console for easy development.
#
# Recommended Production Provider: Resend (https://resend.com)
# RESEND_API_KEY="re_123456789"
# EMAIL_FROM="NOTECRAFT <no-reply@yourdomain.com>"
#
# Alternative: Standard SMTP Server (SendGrid, AWS SES, Mailgun, Postmark)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your_smtp_username"
# SMTP_PASS="your_smtp_password"
#
# Application Frontend URL (for links inside verification and reset emails)
# FRONTEND_URL="http://localhost:3000"
